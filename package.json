{
  "name": "bddb",
  "version": "0.0.0",
  "private": true,
  "description": "Kanban dashboard for beads, built on the bd serve HTTP API",
  "license": "MIT",
  "type": "module",
  "bin": {
    "bddb": "src/server/cli.ts"
  },
  "scripts": {
    "dev": "scripts/dev.sh",
    "serve": "bun src/server/cli.ts serve",
    "doctor": "bun src/server/cli.ts doctor",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit",
    "contract": "bun test tests/contract",
    "gen:api": "scripts/gen-api.sh",
    "gen:api:check": "scripts/gen-api.sh --check",
    "e2e": "playwright test",
    "docker:build": "docker build -t bddb .",
    "dev:mock": "bun src/web/dev/mock-bff.ts"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^3.1.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.2.1",
    "@preact/signals": "^2.11.2",
    "dompurify": "^3.4.15",
    "marked": "^18.0.13",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5"
  }
}
